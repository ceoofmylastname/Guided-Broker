# Always revalidate the HTML so new deploys load immediately (no stale bundles).
# Vite's JS/CSS are content-hashed, so they can be cached forever safely.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
