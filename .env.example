# Copy to .env and fill in real values. .env is gitignored — never commit real keys.
# Powers the RAG backend (ingestion + /api/search). Server-side only.

# Google Gemini — embeddings (gemini-embedding-2-preview, 768-dim)
GEMINI_API_KEY=

# Pinecone — vector store
PINECONE_API_KEY=
# Looks like: https://guidedbroker-xxxx.svc.aped-xxxx.pinecone.io
PINECONE_INDEX_URL=

# LlamaParse — parses PDFs/spreadsheets into clean markdown for ingestion
LLAMA_PARSE_API_KEY=

# Anthropic — optional, only if you enable Claude answer-phrasing later
ANTHROPIC_API_KEY=

# Front-end ElevenLabs agent ID is set in src/config.ts, not here.
